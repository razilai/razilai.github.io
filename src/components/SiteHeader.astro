---
import { Moon, Sun } from '@lucide/astro';
import SocialLinks from './SocialLinks.astro';
import { profile } from '../data/cv';

const nav = [
  { label: 'Projects', href: '/#projects' },
  { label: 'Skills', href: '/#skills' },
  { label: 'Education', href: '/#education' },
];
---

<header
  class="sticky top-0 z-50 border-b border-line bg-bg"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-6">
    <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight text-fg">
      <img src="/favicon.svg" alt="" class="size-7" />
      {profile.name}
    </a>
    <nav class="hidden items-center gap-1 text-sm md:flex">
      {
        nav.map(({ label, href }) => (
          <a
            href={href}
            class="rounded-full px-3 py-1.5 text-muted transition hover:bg-raised hover:text-fg"
          >
            {label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2">
      <SocialLinks size="sm" />
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        title="Toggle dark mode"
        class="grid size-9 cursor-pointer place-items-center rounded-full border border-line bg-surface text-muted transition hover:border-line-strong hover:text-fg"
      >
        <Moon size={16} stroke-width={1.75} class="dark:hidden" aria-hidden="true" />
        <Sun size={16} stroke-width={1.75} class="hidden dark:block" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
  });
</script>
