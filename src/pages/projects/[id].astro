---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ProjectIcon from '../../components/ProjectIcon.astro';
import Tag from '../../components/Tag.astro';
import { profile } from '../../data/cv';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { title, kind, icon, repo, stack, highlights, cover, coverAlt } = project.data;
const { Content } = await render(project);
---

<Layout title={`${title} | ${profile.name}`} description={highlights[0]}>
  <a
    href="/#projects"
    class="text-sm font-medium text-muted transition hover:text-fg"
  >
    ← All projects
  </a>

  <header class="mt-10">
    <ProjectIcon name={icon} size="lg" />
    <p class="mt-6 text-sm text-muted">{kind}</p>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight text-fg sm:text-5xl">
      {title}
    </h1>
    <ul class="mt-6 flex flex-wrap gap-2">
      {
        stack.map((tech) => <Tag>{tech}</Tag>)
      }
    </ul>
    <a
      href={repo}
      class="mt-8 inline-block rounded-full bg-fg px-5 py-2 text-sm font-medium text-bg transition hover:opacity-85"
    >
      View on GitHub ↗
    </a>
  </header>

  {
    cover && (
      <Image
        src={cover}
        alt={coverAlt ?? ''}
        widths={[768, 1536]}
        sizes="(min-width: 768px) 720px, 100vw"
        class="mt-12 max-h-[32rem] w-full rounded-2xl border border-line bg-white object-contain dark:brightness-90"
        loading="eager"
      />
    )
  }

  <article
    class="prose mt-12 max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-a:underline-offset-4 prose-img:rounded-xl prose-img:border prose-img:mx-auto prose-img:max-h-[32rem] prose-img:border-line prose-img:bg-white dark:prose-img:brightness-90 prose-table:text-sm prose-code:before:content-none prose-code:after:content-none"
  >
    <Content />
  </article>

  <nav class="mt-24 flex flex-wrap justify-between gap-4 border-t border-line pt-8 text-sm text-muted">
    <a href="/#projects" class="transition hover:text-fg">← All projects</a>
    <a href={repo} class="transition hover:text-fg">Source on GitHub ↗</a>
  </nav>
</Layout>
