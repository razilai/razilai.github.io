---
import { getCollection } from 'astro:content';
import { MapPin } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LabeledList from '../components/LabeledList.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { profile, education, techStack, aiStack } from '../data/cv';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title={profile.name} wide>
  <section class="flex flex-col items-center pt-8 text-center sm:pt-10">
    <h1 class="text-5xl font-semibold tracking-tight text-balance text-fg">
      {profile.name}
    </h1>
    <p class="mt-3 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-lg text-balance text-muted sm:text-xl">
      <span>{profile.role}, {profile.school}</span>
      <span class="inline-flex items-center gap-1.5 text-sm">
        <MapPin size={14} aria-hidden="true" />
        {profile.location}
      </span>
    </p>
    <p class="mt-4 max-w-4xl text-lg leading-relaxed text-pretty">{profile.summary}</p>
    <SocialLinks class="mt-5 justify-center" />
  </section>

  <main class="divide-y divide-line">
    <Section id="projects" title="Projects" compact>
      <div class="grid gap-5 xl:grid-cols-2">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </Section>

    <Section id="skills" title="Skills">
      <LabeledList rows={techStack} />
    </Section>

    <Section id="education" title="Education">
      <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
        <div>
          <h3 class="text-lg font-semibold text-fg">{education.degree}</h3>
          <p class="mt-1 text-muted">{education.school}</p>
        </div>
        <p class="text-sm text-muted">{education.date}</p>
      </div>
      <p class="mt-3">{education.highlights.join(' · ')}</p>
    </Section>
  </main>
</Layout>
